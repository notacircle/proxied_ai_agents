#!/bin/sh
# nopx — запустить команду мимо прокси (прямое соединение).
# Убирает proxy-переменные, которые Claude передаёт дочерним процессам.
#   nopx curl https://example.com
#   nopx ssh user@host
unset HTTPS_PROXY HTTP_PROXY https_proxy http_proxy ALL_PROXY all_proxy NO_PROXY no_proxy NODE_USE_ENV_PROXY
exec "$@"
